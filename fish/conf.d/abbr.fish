# git
abbr -a -- gs 'git status'
abbr -a --set-cursor='%' gc 'git commit -m "%"'
abbr -a --set-cursor='%' gca 'git commit -am "%"'
abbr -a -- gsw 'git switch '
abbr -a -- gb 'git branch '
abbr -a -- gp 'git pull'
abbr -a -- gpu 'git push'
abbr -a -- gd 'git diff'

# Neovim
abbr -a -- n 'nvim .'

# Zellij
abbr -a -- z 'zellij'
abbr -a -- zl 'zellij --layout'
